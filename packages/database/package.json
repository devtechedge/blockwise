{
  "name": "@blockwise/database",
  "version": "0.1.0",
  "description": "Simple Notion style databases: properties, filters, sorts and CSV",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
